# Google OAuth app credentials (from Google Cloud Console)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Google Ads developer token (from Google Ads API Centre)
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth refresh token for the account you want to query
GOOGLE_ADS_REFRESH_TOKEN=

# The Google Ads customer ID to query (digits only or with dashes, e.g. 123-456-7890)
GOOGLE_ADS_CUSTOMER_ID=

# MCC login customer ID — only needed if querying through a manager account
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
