# Google Ads API credentials
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id          # Web application type in Cloud Console
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret

# Remote server config
SERVER_URL=https://your-app.up.railway.app         # no trailing slash
PORT=8000

# Encryption key for Google refresh tokens stored in SQLite
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key

# Optional: path to SQLite database (default: gads_mcp.db beside project root)
# DB_PATH=/data/gads_mcp.db
